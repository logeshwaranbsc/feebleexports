# FEEBLE EXPORTS - ENVIRONMENT CONFIGURATION TEMPLATE

# Application Setup
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_PATH=/home/username/app

# Database Configuration (MySQL / PostgreSQL / Supabase)
DB_HOST=db.YOUR_SUPABASE_PROJECT_REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=YOUR_DATABASE_PASSWORD


# Mail / Email Service Settings (Optional)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=info@yourdomain.com
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@yourdomain.com
MAIL_FROM_NAME="Feeble Exports"
